{
  "name": "web-fu/proxy",
  "type": "library",
  "description": "Library that allows to access array and object and proxy them",
  "keywords": [
    "php", "php8", "array", "object", "proxy"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Gabriele Manganello",
      "email": "info@web-fu.it",
      "homepage": "https://web-fu.it"
    }
  ],
  "require": {
    "php": "^8.0",
    "web-fu/reflection": "^2.4"
  },
  "autoload": {
    "psr-4": {
      "WebFu\\Proxy\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "WebFu\\Proxy\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5",
    "friendsofphp/php-cs-fixer": "^3.13",
    "phpstan/phpstan": "^2.2",
    "rector/rector": "^2.6"
  },
  "scripts": {
    "cs": "php ./vendor/bin/php-cs-fixer fix --dry-run --allow-risky=yes --stop-on-violation --show-progress dots --verbose",
    "cs-fix": "php ./vendor/bin/php-cs-fixer fix --allow-risky=yes --show-progress dots --verbose",
    "phpstan": "./vendor/bin/phpstan analyse --memory-limit=-1",
    "tests": "./vendor/bin/phpunit --stop-on-failure",
    "rector": "./vendor/bin/rector",
    "rector-dry-run": "./vendor/bin/rector --dry-run"
  }
}
